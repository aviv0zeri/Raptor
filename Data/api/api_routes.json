{
  "api_routes": {
    "description": "API routes for the Raptor trading system",
    "version": "1.0",
    "base_url": "http://localhost:5050",
    "routes": {
      "index": {
        "path": "/",
        "method": "GET",
        "description": "Main API index page",
        "response": "HTML page with API documentation"
      },
      "health": {
        "path": "/health",
        "method": "GET",
        "description": "Health check endpoint",
        "response": {
          "status": "healthy",
          "timestamp": "ISO 8601",
          "services": {
            "api": "running",
            "webhook": "running",
            "model": "running/stopped",
            "bot": "running"
          }
        }
      },
      "model_start": {
        "path": "/api/model/start",
        "method": "POST",
        "description": "Start model with specified interval",
        "body": {
          "model": "real|test",
          "interval": "1m|5m|15m|30m|1h|2h|4h"
        }
      },
      "model_stop": {
        "path": "/api/model/stop",
        "method": "POST",
        "description": "Stop running model"
      },
      "model_status": {
        "path": "/api/model/status",
        "method": "GET",
        "description": "Get current model status"
      },
      "model_signal": {
        "path": "/api/model/signal",
        "method": "POST",
        "description": "Receive signal from model (internal use)"
      },
      "system_status": {
        "path": "/api/system/status",
        "method": "GET",
        "description": "Get overall system status"
      }
    },
    "future_routes": {
      "auth_login": {
        "path": "/auth/login",
        "method": "POST",
        "description": "User authentication (future HTTPS implementation)"
      },
      "auth_logout": {
        "path": "/auth/logout",
        "method": "POST",
        "description": "User logout"
      }
    }
  }
}
