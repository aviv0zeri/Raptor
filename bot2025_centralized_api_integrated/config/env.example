# 🌟 Trading Bot Environment Configuration
# Copy this file to .env and fill in your actual values

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trading_bot
DB_USER=postgres
DB_PASSWORD=your_database_password

# Binance API Configuration
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here

# Bybit API Configuration (optional)
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_SECRET_KEY=your_bybit_secret_key_here

# Request Configuration
REQUEST_TIMEOUT=10
MAX_RETRIES=5

# Trading Configuration
DEFAULT_QUANTITY=1.0
MAX_POSITION_SIZE=100.0
RISK_PERCENTAGE=2.0
ENABLE_PAPER_TRADING=true
DEFAULT_EXCHANGE=binance

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
ENABLE_CONSOLE_LOGGING=true
MAX_LOG_SIZE=10485760

# Performance Configuration
WALLET_UPDATE_INTERVAL=30
PRICE_UPDATE_INTERVAL=5
ENABLE_CACHING=true
CACHE_TTL=300

# Web Interface Configuration
WEB_HOST=localhost
WEB_PORT=5001
DEBUG_MODE=false
ENABLE_CORS=true

# Webhook and WebSocket Configuration
WEBHOOK_URL=http://localhost:5001/webhook
WEBHOOK_ENABLED=true
WEBSOCKET_PORT=8765

# React Frontend Configuration
REACT_PORT=3000
REACT_HOST=localhost

# PostgreSQL Configuration
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Centralized Logging Configuration
LOG_DIR=logs/categories
