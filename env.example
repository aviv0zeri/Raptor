# Raptor Trading Bot - Environment Configuration Example
# Copy this file to .env and replace with your actual API keys

# Binance API Configuration
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here

# Webhook Configuration
WEBHOOK_URL=http://localhost:5001/webhook
WEBHOOK_PORT=5001

# Database Configuration
DATABASE_URL=sqlite:///raptor_bot.db
DATABASE_NAME=raptor_bot

# Trading Configuration
TEST_MODE=true
DEFAULT_COIN=CHZ
BASE_COIN=USDT
TRADE_AMOUNT=10.0

# Model Configuration
MODEL_INTERVAL=1m
TARGET_CURRENCY=CHZUSDT
MODEL_OUTPUT_PATH=model_output.csv

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=app.log

# Sound Configuration
ENABLE_SOUNDS=true
SOUND_VOLUME=0.5

# Frontend Configuration
FRONTEND_PORT=5173
FRONTEND_URL=http://localhost:5173

# Debug Configuration
DEBUG_MODE=false
ENABLE_DEBUGGER=true

# Example generated keys (DO NOT USE IN PRODUCTION):
# BINANCE_API_KEY=8f7d9e6c5b4a3928f7d9e6c5b4a3928f7d9e6c5b4a3928f7d9e6c5b4a3928
# BINANCE_SECRET_KEY=a1b2c3d4e5f6789012345678901234567890abcdef1234567890abcdef1234
